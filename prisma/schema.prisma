generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}


enum UserRole {
  ADMIN
  EMPLOYEE
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
}

// ----------------------------------
// USER
// ----------------------------------

model User {
  id           String   @id @default(uuid()) @db.Uuid
  employeeId   String   @unique
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(EMPLOYEE)
  isActive     Boolean  @default(true)

  // Templates created by this employee
  createdTemplates Template[] @relation("TemplateCreatedBy")

  // Templates last updated by this employee
  updatedTemplates Template[] @relation("TemplateUpdatedBy")

  // Import history
  importBatches ImportBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([isActive])
  @@map("users")
}

// ----------------------------------
// SMS TEMPLATE
// ----------------------------------

model Template {
  id String @id @default(uuid()) @db.Uuid

  // Original Excel fields

  dltTemplateId String @unique
  name          String
  dueDate       String
  content       String   @db.Text
  ownerName     String
  remarks       String?  @db.Text

  // Two attachment URL fields

  attachmentLink1 String? @db.Text
  attachmentLink2 String? @db.Text

  // Template management

  isActive Boolean @default(true)

  // Created by employee

  createdById String? @db.Uuid
  createdBy   User?   @relation("TemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Last updated by employee

  updatedById String? @db.Uuid
  updatedBy   User?   @relation("TemplateUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  // Bulk import reference

  importBatchId String?      @db.Uuid
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Search and filtering indexes

  @@index([name])
  @@index([dueDate])
  @@index([ownerName])
  @@index([isActive])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([createdById])
  @@index([importBatchId])

  @@map("templates")
}

// ----------------------------------
// BULK IMPORT HISTORY
// ----------------------------------

model ImportBatch {
  id String @id @default(uuid()) @db.Uuid

  fileName String
  fileType String

  status ImportStatus @default(PENDING)

  totalRecords    Int @default(0)
  successfulCount Int @default(0)
  skippedCount    Int @default(0)
  failedCount     Int @default(0)

  // Optional error details for failed rows
  errorReport Json?

  importedById String @db.Uuid
  importedBy   User   @relation(fields: [importedById], references: [id], onDelete: Restrict)

  templates Template[]

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([status])
  @@index([importedById])
  @@index([createdAt])

  @@map("import_batches")
}
